# --- Database ---
DATABASE_URL="postgres://glammy:glammy@localhost:5432/glammy_studio"

# --- Server ---
PORT=3000
PUBLIC_API_URL="http://localhost:3000"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_EXPIRES="30d"

# --- AI ---
# mock | openai
AI_PROVIDER="mock"
# Used by the OpenAI adapter; leave empty to keep the mock provider active.
OPENAI_API_KEY=""
# Optional: override the model used by the OpenAI adapter.
OPENAI_MODEL="gpt-image-2"

# --- Storage ---
# Local-disk storage is used when Cloudinary vars are absent.
# STORAGE_UPLOAD_DIR="uploads"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
